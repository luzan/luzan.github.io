<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Index</title>
    <style>
        table, th, td {
            border:1px solid black;
            border-collapse:collapse;
        }
        td, th {
            padding: 3px;
        }
    </style>
</head>
<body>
    <h1><%= data.Title %> </h1>
    <p><%= data.text %> </p>
    <ul>
        <% list.forEach(element => { %>
            <li><%= element.name %></li>
            <ul>
                <% element.courses.forEach(course => { %>
                   <li>
                    <%= course %> 
                   </li> 
                <% }) %>
            </ul>
        <% }) %>
    </ul>
    <hr>
    <span><%= table.Name %></span> </br>
    <span><%= table.Location %></span> </br>
    <span><%= table.Availability %></span> </br>
    <% if (table.Courses != null) { %>
     <span>Courses</span>
     <table>
         <tr>
             <% Object.keys(table.Courses).forEach(function(key) { %>
                <th><%= key %></th>
             <% }); %>
         </tr>
         <tr>
            <% Object.keys(table.Courses).forEach(function(key) { %>
                <td><%= table.Courses[key] %></td>
             <% }); %>
         </tr>
     </table>
    <% } %>
    <hr>
    <a href="/ajax">Go to Ajax Demo</a>
</body>
</html>