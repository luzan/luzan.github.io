<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ajax Demo</title>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        $(function () {
            const $form = $('#dataForm')

            $form.on('submit', submitHandler)

            function submitHandler(e) {
                e.preventDefault()

                // data collection
                let heading = $('#forHeading').val();
                let color = $('#forColor').val();
                $.ajax({
                    url: '/ajax',
                    type: 'POST',
                    data: {"heading": heading, "color": color }
                }).done(response => {
                    console.log(response)
                    $('#heading').html(response.heading);
                    $('#colorbox').css('background-color', response.color);
                }).fail(function() {
                    console.log('Ajax Request Failed')
                })
            }
        });
    </script>
</head>

<body>
    <h1 id="heading">This can be changed</h1>
    <div id="colorbox" style="position:relative;height: 200px;width: 200px;background-color: aqua;"></div>
    <form action="/" method="post" id="dataForm" style="margin-top: 15px;">
        <label for="forHeading"> Heading Text:
            <input type="text" name="heading" id="forHeading">
        </label> <br>
        <label for="forColor"> Box Color:
            <input type="text" name="color" id="forColor">
        </label>
        <input type="submit" value="Change">
    </form>
</body>

</html>