<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
</head>

<body>
    <% if (data==null) { %>
        <form method="post" action="/form" id="id">
            Name : <input id="inputText" name="name" type="text" />
            <br>
            <br>
            Description : <textarea id="inputTextArea" name="description" type="text" row="20" col="4"></textarea>
            <br>
            <br>
            Gender : <div style="display: inline-block" id="radioGroup">
                <input type="radio" name="gender" checked="checked" value="Male">Male</input>
                <input type="radio" name="gender" value="Female">Female</input>
                <input type="radio" name="gender" value="Other"> Other</input>
            </div>
            <br>
            <br>
            Age Group :
            <select id="selectId" name="ageGroup">
                <option value="12-18">12-18</option>
                <option value="18-25">18-25</option>
                <option value="25-35">25-35</option>
                <option value="35-45">35-45</option>
            </select>
            <br>
            <br>
            Hobbies : <div style="display: inline-block" id="checkboxGroup">
                <input type="checkbox" name="hobbies" checked="checked" value="Swimming">Swimming</input>
                <input type="checkbox" name="hobbies" value="Cycling">Cycling</input>
                <input type="checkbox" name="hobbies" value="Hiking">Hiking</input>
            </div>
            <br>
            <br>
            <input type="submit" />
            <button type="button" id="reload">Clear</button>
            </div>
            <% } else { %>
                <label>Name: <%= data.name %> </label>
                <br>
                <label>Description: <%= data.description %></label>
                <br>
                <label>Gender:
                    <%= data.gender %>
                </label>
                <br>
                <label>Age Group: <%= data.ageGroup %></label>
                <br><label>Hobbies: <%= data.hobbies %></label>
                <br><br>
                <h3>User Count: 0</h3>
                <a href='/'> Go Back to Form</a>
                <br />
                <a href='/error'> Go to Error</a>
                <br />
                <a href='/no-page'> Gives 404</a> <br />
                <% } %>
</body>

</html>